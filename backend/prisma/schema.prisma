// Academix AI Academic Assistant
// Database Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ====================
// USER
// ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses       Enrollment[]
  conversations Conversation[]
  assignments   Assignment[]
}


// ====================
// COURSE
// ====================

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students    Enrollment[]
  materials   Material[]
  assignments Assignment[]
}


// ====================
// ENROLLMENT
// ====================

model Enrollment {
  id        String   @id @default(cuid())

  userId    String
  courseId  String

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}


// ====================
// STUDY MATERIAL
// ====================

model Material {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String?

  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}


// ====================
// ASSIGNMENT
// ====================

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      AssignmentStatus @default(PENDING)

  userId      String
  courseId    String

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}


// ====================
// AI CONVERSATION
// ====================

model Conversation {
  id        String   @id @default(cuid())
  title     String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ====================
// AI MESSAGE
// ====================

model Message {
  id             String       @id @default(cuid())
  content        String
  sender         MessageSender

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
}


// ====================
// ENUMS
// ====================

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum AssignmentStatus {
  PENDING
  COMPLETED
}

enum MessageSender {
  USER
  AI
}

model Document {
  id        String   @id @default(cuid())
  title     String
  filename  String
  path      String
  mimetype  String
  size      Int
  extractedText String?

  chunks       DocumentChunk[]
  conversations Conversation[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DocumentChunk {
  id         String   @id @default(cuid())
  content    String
  chunkIndex Int
  embedding  Float[]

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}